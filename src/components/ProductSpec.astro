<section class="detail">
  <div class="detail-head">
    <span>[ SPEC // {spec} ]</span>
    <span>{code}</span>
  </div>

  <div class="detail-hero">
    <div class="detail-info">
      <span class="mono">SECTION // 02.1 — SPEC SHEET</span>

      <h1 class="detail-title">{name}</h1>
      <p class="detail-subtitle">{subtitle}</p>

      <div class="detail-meta">
        {meta.map((row) => (
          <span class="meta-tag">
            <b>{row.label}</b>
            <span>{row.value}</span>
          </span>
        ))}
      </div>

      <div class="detail-actions">
        {demo?.href && (
          <a
            href={demo.href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-solid magnetic interactable"
          >
            <span>RUN DEMO</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
        {demo?.alert && (
          <button
            type="button"
            class="btn btn-solid magnetic interactable"
            onclick={`alert('${demo.alert}'); return false;`}
          ><span>RUN DEMO</span></button>
        )}
        <slot />
        <a href="/projects" class="btn btn-ghost magnetic interactable">
          <span>BACK TO ARSENAL</span>
        </a>
      </div>

      <div class="detail-highlights">
        <h2>项目亮点</h2>
        <ul>
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="detail-visual">
      {hasImage ? (
        <img
          src={image}
          alt={imageAlt || name}
          role="button"
          tabindex="0"
          aria-label={`放大查看 ${name}`}
          onclick={`openImageViewer('${image}', '${name}')`}
          onkeydown={`if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openImageViewer('${image}', '${name}'); }`}
        />
      ) : (
        <div class="detail-visual-placeholder">
          <span class="placeholder-text">{placeholder?.title || name}</span>
          <span class="placeholder-subtext">{placeholder?.subtext}</span>
        </div>
      )}
    </div>
  </div>

  <div class="log-head">
    <span>CHANGE LOG</span>
    <span>{String(updates.length).padStart(2, '0')} ENTRIES // DESC</span>
  </div>

  <div>
    {updates.map((entry) => (
      <div class="log-entry">
        <div class="log-date">{entry.date}</div>
        <div class="log-details">
          {entry.details.map((detail) => (
            <p>{detail}</p>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

{hasImage && (
  <div class="image-viewer" id="imageViewer" onclick="closeImageViewer(event)">
    <div class="image-viewer-backdrop interactable"></div>
    <div class="image-viewer-content">
      <button
        type="button"
        class="image-viewer-close interactable"
        onclick="closeImageViewer(event)"
        aria-label="关闭图片查看器"
      >×</button>
      <img id="viewerImage" alt="" />
      <div class="image-viewer-caption" id="viewerCaption"></div>
    </div>
  </div>
)}

