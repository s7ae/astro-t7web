<BaseLayout title="s7eet — s7ae 网络科技工作室">
  <Header currentPage="/projects" />

  <main id="main">

  <ProductSpec
    spec="02.1"
    code="S7EET/0001"
    name="s7eet"
    subtitle="Skeet Crack NextGen"
    meta={meta}
    highlights={[
      '单EXE打包设计，无凌乱文件',
      '自动开启游戏且已设置好游戏启动项',
      '主要支持库都从本站动态拉取',
    ]}
    updates={updates}
    image="/assets/images/s7eet.jpg"
    imageAlt="s7eet"
    demo={{ href: 'https://www.bilibili.com/video/BV1ok9aBHEZ1/?share_source=copy_web&vd_source=88c5c8a4ff8bd601a51a57e5d72d0e40' }}
  >
    <button
      type="button"
      class="btn btn-ghost magnetic interactable"
      onclick="openReadmeModal()"
    >
      <span>DOWNLOAD BUILD</span>
      <span aria-hidden="true">↓</span>
    </button>
  </ProductSpec>

  
  <div class="readme-modal" id="readmeModal" role="dialog" aria-modal="true" aria-label="使用前须知">
    <div class="readme-overlay interactable" onclick="closeReadmeModal()"></div>
    <div class="readme-container">
      <div class="readme-header">
        <span class="readme-icon" aria-hidden="true">▤</span>
        <h2 class="readme-title">使用前须知</h2>
        <button type="button" class="readme-close interactable" onclick="closeReadmeModal()" aria-label="关闭">
          ×
        </button>
      </div>

      <div class="readme-content">
        {briefing.map((section) => (
          <div class="readme-section">
            <h3>{section.title}</h3>
            <div class="readme-placeholder">{section.body}</div>
          </div>
        ))}
      </div>

      <div class="readme-footer">
        <label class="readme-checkbox">
          <input type="checkbox" id="agreeCheckbox" />
          <span class="checkbox-custom"></span>
          <span class="checkbox-text">我已阅读并同意以上所有条款</span>
        </label>
        <a
          href="https://old.s7ae.cc/assets/s7eet.exe"
          id="downloadBtn"
          onclick="handleDownload(event)"
          class="btn-download"
        >
          <span>确认下载</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>

