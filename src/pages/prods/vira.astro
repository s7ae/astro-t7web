  description="Vira Theme：Material Theme 的官方继任者，覆盖 VS Code 与 JetBrains 的深色主题体系。"
>
  <Header currentPage="/projects" />

  <main id="main">
    <section class="detail">
      <div class="detail-head">
        <span>[ SPEC // 02.6 ]</span>
        <span>VIRA-THEME/0006</span>
      </div>

      <div class="detail-hero">
        <div class="detail-info">
          <span class="mono">SECTION // 02.1 — SPEC SHEET</span>

          <h1 class="detail-title">Vira Theme Crack</h1>
          <p class="detail-subtitle">Vira Theme Crack&s7aeEdition version</p>

          <div class="detail-meta">
            {meta.map((row) => (
              <span class="meta-tag">
                <b>{row.label}</b>
                <span>{row.value}</span>
              </span>
            ))}
          </div>

          <div class="detail-actions">
            <a
              href="https://old.s7ae.cc/assets/s7ae-Vira-theme-cracked.zip"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-solid magnetic interactable"
            >
              <span>GET VIRA THEME</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="/projects" class="btn btn-ghost magnetic interactable">
              <span>BACK TO ARSENAL</span>
            </a>
          </div>

          <div class="detail-highlights">
            <h2>产品要点</h2>
            <ul>
              {highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="detail-visual">
          <img
            src="/assets/vira/vscode-carbon.png"
            alt="Vira Theme Carbon 变体在 VS Code 中的完整界面"
            width="2070"
            height="1278"
          />
        </div>
      </div>

      
      <div class="log-head">
        <span>ONE SYSTEM // TWO SURFACES</span>
        <span>02 TARGETS</span>
      </div>

      <div class="platform-grid">
        {platforms.map((platform) => (
          <article class="platform-cell">
            <div class="platform-shot">
              <img
                src={platform.shot}
                alt={platform.alt}
                width={platform.width}
                height={platform.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div>
              <h2 class="platform-name">{platform.name}</h2>
              <p class="platform-note">{platform.note}</p>
            </div>
          </article>
        ))}
      </div>

      
      <div class="log-head">
        <span>VARIANTS</span>
        <span>06 // DARK ONLY</span>
      </div>

      <div class="variant-list">
        {variants.map((variant) => (
          <span class="variant-chip">{variant}</span>
        ))}
      </div>

      
      <div class="log-head">
        <span>CONFIGURATION</span>
        <span>EVERY KNOB EXPOSED</span>
      </div>

      <div class="detail-hero">
        <div class="detail-info">
          <div class="detail-highlights">
            <h2>可调项</h2>
            <ul>
              {knobs.map((knob) => (
                <li>
                  <b>{knob.name}</b> — {knob.note}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="detail-visual">
          <img
            src="/assets/vira/settings.png"
            alt="Vira Theme 在 VS Code 设置面板中的可配置项"
            width="1031"
            height="691"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="cta-panel" style="border-top:1px solid var(--border-hairline);">
