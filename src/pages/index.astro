          <span class="friend-row-index">{String(index + 1).padStart(2, '0')} // EXTERNAL</span>
          <div>
            <h3>{project.name}</h3>
            <p style="margin-top:0.5rem;">{project.description}</p>
          </div>
          <span class="friend-row-enter" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  
  <section class="block console-section" id="simulation" style="border-bottom:1px solid var(--border-hairline);">
    <div class="console-layout">
      <div class="console-side">
        <span class="mono">SECTION // 04 — DELIVERY SIMULATION</span>
        <h2 class="console-title">
          ONE SPEC.<br />
          FOUR <span class="serif">stacks</span>.
        </h2>
        <p class="console-lede">
