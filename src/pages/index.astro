  <Header currentPage="/" />

  <main id="main">

  
  <section class="hero">
    <div class="hero-top hero-intro" style="transition-delay:0.05s">
      <span>[ BGP ANYCAST // 38 POP NODES ONLINE ]</span>
      <span>[ CLICK ANYWHERE TO TRIGGER GRAVITY WAVE ]</span>
      <span id="utc-clock">UTC // 00:00:00</span>
    </div>

    <div class="hero-core">
      <div class="hero-kicker hero-intro" style="transition-delay:0.15s">
        <p class="serif">Software, silicon and the unreasonable precision in between.</p>
        <span class="mono">[ 网络科技工作室 // EST. 2021 ]</span>
      </div>

      <h1 class="hero-slab" aria-label="s7ae">
        {slabChars.map((char, index) => (
          <span
            class="slab-char"
            style={`transition-delay:${(0.05 + index * 0.07).toFixed(2)}s`}
            aria-hidden="true"
          >{char}</span>
        ))}
      </h1>

      <div class="hero-statement">
        <div>
          <p class="hero-lede hero-intro" style="transition-delay:0.6s">
            我们不生产点子，我们<strong>把点子压成可交付的工程</strong>。
            承接高质量的软硬件定制、系统集成与界面设计，把每一处性能预算和交互细节都当作必须兑现的合约。
          </p>
          <div class="hero-actions hero-intro" style="transition-delay:0.7s">
            <a href="/projects" class="btn btn-solid magnetic interactable">
              <span>INSPECT ARSENAL</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/contact" class="btn btn-ghost magnetic interactable">
              <span>OPEN A CHANNEL</span>
            </a>
          </div>
        </div>

        <div class="hero-copy hero-intro" style="transition-delay:0.78s">
          <span class="hero-copy-label">CLICK TO DECRYPT &amp; COPY DIRECT HANDLE</span>
          <button
            type="button"
            class="copy-target magnetic interactable"
            onclick="igniteHandle()"
            aria-label="复制 Telegram 联络地址"
          >
            <span class="copy-target-value" id="scramble-handle">T.ME/EVOLUTIONGS</span>
            <span class="copy-target-badge" id="copy-badge">COPY</span>
          </button>
        </div>
      </div>
    </div>

    <div class="hero-foot hero-intro" style="transition-delay:0.9s">
      {metrics.map((metric) => (
        <div class="hero-metric">
          <span class="hero-metric-label">{metric.label}</span>
          <span
            class="hero-metric-value scramble"
            data-scramble={metric.value}
          >{metric.value}</span>
        </div>
      ))}
      <div class="hero-scroll">
        <span>SCROLL TO DESCEND ↓</span>
      </div>
    </div>
  </section>

  
  <div class="marquee hero-intro" aria-hidden="true" style="transition-delay:1.15s;">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <Fragment>
          <span>{item}</span>
          <span class="sep">✦</span>
        </Fragment>
      ))}
    </div>
  </div>

  
  <section class="manifesto" id="manifesto">
    <div class="manifesto-lead crosshair">
      <div>
        <span class="mono">SECTION // 01 — MANIFESTO</span>
        <h2>
          ARCHITECTING<br />
          THE <span class="serif">unreasonable</span><br />
          STANDARD.
        </h2>
      </div>
      <p class="manifesto-lead-note">
        平庸的供应商堆砌圆角与霓虹渐变；<br />
        s7ae 重构的是需求、性能与交付边界本身。
      </p>
    </div>

    <div class="manifesto-cells">
      {pillars.map((pillar) => (
        <article class="manifesto-cell spotlight crosshair">
