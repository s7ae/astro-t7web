              class="stack-btn interactable"
              data-stack={stack.id}
              aria-pressed={index === 0 ? 'true' : 'false'}
              onclick={`selectStack('${stack.id}')`}
            >{stack.name}</button>
          ))}
        </div>
      </div>

      <div class="console-frame">
        <div class="console-bar">
          <span id="console-file">TERMINAL // {stacks[0].file}</span>
          <button type="button" class="interactable console-run" onclick="runBuild()">
            [ ▶ EXECUTE BUILD ]
          </button>
        </div>
        <div class="console-body">
          <pre class="console-code" id="stack-code">{stacks[0].code.split('\n').map((line, i) => (<span class="code-row"><span class="code-ln">{String(i + 1).padStart(2, '0')}</span><span class="code-tx">{line || ' '}</span></span>))}</pre>
          <div class="console-out">
            <div class="console-out-label">// BUILD TELEMETRY:</div>
            <div id="build-output">&gt; READY. AWAITING EXECUTION SIGNAL.</div>
          </div>
        </div>
      </div>
    </div>

    <div id="stack-data" hidden data-json={JSON.stringify(stacks)}></div>
  </section>

  
  <section class="cta-panel">
    <p class="cta-kicker">[ READY TO COMMISSION? ]</p>
    <h2>
      COMMISSION<br />
      A <span class="serif">build</span> THAT HOLDS.
    </h2>
    <div class="cta-side">
      <p>
        [ 需求评审 → 方案冻结 → 分阶段交付 → 验收 ]<br />
        所有项目按里程碑结算，不设模糊工期。
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:0.6rem;">
        <a
