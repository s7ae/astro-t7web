<BaseLayout title="联系我们 — s7ae 网络科技工作室">
  <Header currentPage="/contact" />

  <main id="main">

  <section class="block" style="padding-top:calc(var(--hud-h) + 0px);">
    <div class="section-head">
      <div>
        <span class="mono" style="display:block;margin-bottom:0.85rem;">SECTION // 04 — CHANNEL</span>
        <h1>OPEN A <span class="serif" style="color:var(--text-titanium);">direct</span> CHANNEL</h1>
      </div>
      <p class="section-note">
        [ DIRECT PEERING ONLY ]<br />
        无论您有任何问题或需求，都欢迎与我们联系。请优先附上环境、目标和时间窗，我们能直接给出可执行答复。
      </p>
    </div>

    <div class="channel-list">
      {channels.map((channel) => (
        <a
          href={channel.href}
          target="_blank"
          rel="noopener noreferrer"
          class="channel interactable"
        >
          <span class="channel-glyph" aria-hidden="true">{channel.glyph}</span>
          <div class="channel-body">
            <span class="channel-title">{channel.title}</span>
            <span class="channel-handle">{channel.handle} // {channel.note}</span>
          </div>
          <span class="channel-enter" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  
  <section class="block">
    <div class="section-head" style="padding-top:0;">
      <div>
        <span class="mono" style="display:block;margin-bottom:0.85rem;">SECTION // 04.1 — PROTOCOL</span>
        <h2>ENGAGEMENT <span class="serif" style="color:var(--text-titanium);">protocol</span></h2>
      </div>
    </div>

    <div class="project-list">
      {protocol.map((row, index) => (
        <div class="project-row" style="cursor:default;">
          <div class="project-row-inner" style="grid-template-columns:3.5rem minmax(0,1fr) minmax(0,auto);">
            <span class="project-row-index">{String(index + 1).padStart(2, '0')} //</span>
            <span class="project-row-name" style="font-size:clamp(0.95rem,1.6vw,1.15rem);">{row.label}</span>
            <span class="mono" style="color:#fff;justify-self:end;text-align:right;">{row.value}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-panel" style="border-top:1px solid var(--border-hairline);">
    <h2>
      GET THE<br />
      <span class="serif">apps</span>, THEN TALK.
    </h2>
    <div class="cta-side">
      <p>
        [ 有任何问题或合作意向？请通过 Telegram 或 Discord 与我们联系 ]<br />
        我们将尽快回复您。
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:0.6rem;">
        <a
          href="https://telegram.org/apps"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-solid magnetic interactable"
        >
          <span>DOWNLOAD TELEGRAM</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://discord.com/download"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost magnetic interactable"
        >
          <span>DOWNLOAD DISCORD</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

