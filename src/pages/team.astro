    <div class="roster">
      {roster.map((member, index) => (
        <div
          class="roster-row"
          data-special={member.special ? 'true' : 'false'}
          role={member.special ? 'button' : undefined}
          tabindex={member.special ? '0' : undefined}
        >
          <span class="roster-index">{String(index + 1).padStart(2, '0')} //</span>

          <div class="roster-avatar">
            <img
              src={member.avatar}
              alt={`${member.name} 头像`}
              loading="lazy"
              style={member.sepia ? 'filter:sepia(1) hue-rotate(120deg) saturate(0.8) brightness(1.1);' : undefined}
            />
            {member.frame && (
              <img src={member.frame} alt="" class="roster-avatar-frame" aria-hidden="true" />
            )}
            {member.hasBadge && (
              <span class="roster-badge">
                <img src="/assets/Hysteria/enqDev.webp" alt="enQ Dev" />
              </span>
            )}
          </div>

          <div class="roster-id">
            <h2 class="roster-name">{member.name}</h2>
            <span class="roster-role">
              {member.link ? (
                <a href={member.link} target="_blank" rel="noopener noreferrer" class="interactable">
                  {member.title}
                </a>
              ) : (
                member.title
              )}
            </span>
          </div>

          <p class="roster-bio">{member.description}</p>

          <div class="roster-tags">
            {member.resolvedTags.map((tag) =>
              typeof tag === 'string' ? (
                <span class="tag">{tag}</span>
              ) : tag.link ? (
                <a
                  href={tag.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tag interactable"
                >{tag.text}</a>
              ) : (
                <span class="tag">{tag.text}</span>
              )
            )}
          </div>

          {member.special && (
            <audio preload="auto">
              <source src="/assets/Sound/LC.WAV" type="audio/wav" />
            </audio>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="cta-panel" style="border-top:1px solid var(--border-hairline);">
    <h2>
      WANT YOUR<br />
      CALLSIGN <span class="serif">logged</span>?
    </h2>
    <div class="cta-side">
      <p>
        [ 名单只记录真正参与过交付的人 ]<br />
        如果你能在工程里留下痕迹，这条通道随时开放。
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:0.6rem;">
        <a href="/contact" class="btn btn-solid magnetic interactable">
          <span>OPEN A CHANNEL</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

